# Supabase project settings (Project Settings → API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only — never expose to the browser or commit real values
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Order confirmation emails (Resend — resend.com)
RESEND_API_KEY=re_your-api-key
EMAIL_FROM=Glenhaven Snow <salt@glenhavensnow.com>
